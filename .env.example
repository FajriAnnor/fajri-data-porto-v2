# Copy to .env (gitignored) to override defaults. Variables already set in the environment win.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# auto = Secure cookies only over HTTPS (or X-Forwarded-Proto: https); true / false to force
COOKIE_SECURE=auto
# Contact form. true = use the first X-Forwarded-For value as the client IP (ONLY behind your own reverse proxy)
TRUST_PROXY=false
# Optional extra origins allowed to POST /api/contact (comma separated, e.g. https://example.com). Same-host posts are always allowed.
ALLOWED_ORIGINS=
